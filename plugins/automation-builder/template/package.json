{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pipeline": "node src/cli/pipeline.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:framework": "tsc --noEmit -p tsconfig.framework.json",
    "test:pipeline": "node --test \"tests/pipeline/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm run test:pipeline",
    "demo:app": "node demo/server.ts"
  }
}
