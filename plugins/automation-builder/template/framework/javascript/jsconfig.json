{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "playwright.config.js",
    "fixtures/**/*.js",
    "pages/**/*.js",
    "helpers/**/*.js",
    "auth/**/*.js",
    "test-data/**/*.js",
    "tests/**/*.js",
    "../dependencies/engine/config/**/*.ts"
  ]
}
