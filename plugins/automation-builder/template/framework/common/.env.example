# Copy to .env (git-ignored) and fill in real values locally.
# Never commit real credentials. Placeholders only in this file.
# Credentials and emails found in your test cases are added to .env (and their names here) by the pipeline;
# you only fill in what is left empty.

# Overrides config/automation.config.json -> app.baseUrl
PW_BASE_URL=

# Overrides config/automation.config.json -> app.environment
PW_ENVIRONMENT=

# Test account credentials (only if the authentication approach requires them)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
