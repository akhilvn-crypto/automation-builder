{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "es2023",
      "dom"
    ]
  },
  "include": [
    "playwright.config.ts",
    "src/fixtures/**/*.ts",
    "src/pages/**/*.ts",
    "src/tools/**/*.ts",
    "src/utils/**/*.ts",
    "src/config/**/*.ts",
    "tests/generated/**/*.ts",
    "tests/handwritten/**/*.ts",
    "tests/**/*.setup.ts"
  ]
}
